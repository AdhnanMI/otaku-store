# PostgreSQL connection string.
# Local:      postgresql://postgres:postgres@localhost:5432/otaku_store
# Neon:       postgresql://<user>:<password>@<host>/<db>?sslmode=require
# Supabase:   postgresql://postgres:<password>@<host>:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/otaku_store"

# Any long random string — used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-string"

PORT=4000

# Comma-separated list of frontend origins allowed to call this API.
CLIENT_ORIGIN="http://localhost:5173"
